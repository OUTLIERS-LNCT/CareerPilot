APP_ENV=development
DATABASE_URL=postgresql+psycopg://preppilot:local-dev-only@localhost:5432/preppilot
FRONTEND_ORIGINS=["http://localhost:4173","http://localhost:5173","http://localhost:8000"]
COOKIE_SECURE=false
